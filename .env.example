# =====================================================================
# MATRIXCMS - Environment Configuration Template
# Department of Computer Science & Engineering, Chandigarh
# =====================================================================

# Application Branding
PROJECT_NAME=MATRIXCMS
PORTAL_TITLE="MATRIXCMS: Expedition & Scientific Research Portal"
INSTITUTION=Chandigarh
DEPARTMENT=CSE
APP_ENV=development

# Database Connection
# SQLite (default for development):
DATABASE_URL=sqlite:///./matrixcms.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/matrixcms

# Security & Authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=matrixcms_secret_key_change_in_production_f72389d7fae29bc
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage Configuration
STORAGE_ROOT=./storage/uploads

# Scheduler Settings
SCHEDULER_INTERVAL_MINUTES=15

# =====================================================================
# Free LLM Configuration (OpenAI-Compatible Providers)
# =====================================================================

# Option A: Groq Cloud (Free Tier - https://console.groq.com)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_placeholder_replace_with_your_free_key
LLM_MODEL=llama-3.1-8b-instruct

# Option B: Local Ollama (Offline / No Key Required)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b

# Option C: Cloudflare Workers AI (Free Daily Neurons)
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/{ACCOUNT_ID}/ai/v1
# LLM_API_KEY={CLOUDFLARE_API_TOKEN}
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
